# Copy to BACKEND/.env and fill in real values. Never commit .env.

# ---- Required: JWT signing ----
# Must be at least 32 characters. The app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long an access token stays valid, in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Required: CORS ----
# Comma-separated list of exact frontend origins. No wildcards, no trailing slash.
# Add your deployed frontend origin here before going live.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Required for Google sign-in ----
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Add your frontend origin to "Authorized JavaScript origins".
# The frontend needs this same client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ---- Optional: database ----
# Defaults to a local SQLite file. Use a Postgres URL in production.
DATABASE_URL=sqlite:///./pitchpal.db
