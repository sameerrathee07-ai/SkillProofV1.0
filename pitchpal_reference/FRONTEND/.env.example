# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_,
# and it inlines them at build time — never put a secret in here.

# Where the FastAPI backend lives, including the /api prefix.
VITE_API_BASE=http://localhost:8000/api

# Google OAuth 2.0 Web client ID, e.g. 1234567890-abc123.apps.googleusercontent.com
# Leave empty to hide the "Continue with Google" button entirely.
# The same value must be set as GOOGLE_CLIENT_ID in BACKEND/.env — the server
# verifies the ID token's audience against it.
# In Google Cloud Console the client needs http://localhost:5173 listed under
# "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
